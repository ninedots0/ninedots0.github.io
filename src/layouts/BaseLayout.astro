---
import type { SiteMeta } from 'astro-pure/types'
import BaseHead from '@/components/BaseHead.astro'
import Search from '@/components/Search.astro'
import '@/assets/styles/global.css'
import '@/assets/styles/app.css'
import '@/assets/styles/minimal.css'
interface Props { meta: SiteMeta; highlightColor?: string; class?: string }
const { meta, class: className } = Astro.props
---
<html lang='en'>
  <head><BaseHead {...meta} /></head>
  <body class:list={['minimal-site', className]}>
    <div id='main-container'>
      <header class='site-header' data-pagefind-ignore>
        <a class='site-name' href='/'>9dots</a>
        <nav aria-label='Main navigation'>
          <a href='/about'>About</a>
          <button type='button' data-search-open aria-label='Search articles' aria-haspopup='dialog' aria-controls='search-dialog'>
            <svg width='16' height='16' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.5' aria-hidden='true'><circle cx='10.5' cy='10.5' r='6.5'/><path d='m16 16 5 5'/></svg>
          </button>
        </nav>
      </header>
      <slot />
    </div>
    <Search />
  </body>
</html>
