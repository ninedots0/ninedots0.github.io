---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'

import { Paginator } from 'astro-pure/components/pages'
import { getBlogCollection } from 'astro-pure/server'
import PostIndex from '@/components/PostIndex.astro'
import PageLayout from '@/layouts/BaseLayout.astro'
import config from '@/site-config'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  // Publication order is independent of subsequent edits.
  const collections = (await getBlogCollection() as CollectionEntry<'blog'>[]).sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
  )
  return paginate(collections, { pageSize: config.content.blogPageSize })
}) satisfies GetStaticPaths

interface Props {
  page: Page<CollectionEntry<'blog'>>
}

const { page } = Astro.props

const meta = {
  description: 'Some posts or archives of my blog',
  title: 'Blog'
}

const paginationProps = {
  ...(page.url.prev && {
    prevUrl: {
      text: `← Previous Posts`,
      url: page.url.prev
    }
  }),
  ...(page.url.next && {
    nextUrl: {
      text: `Next Posts →`,
      url: page.url.next
    }
  })
}
---

<PageLayout {meta}>
  <main><h1 class='visually-hidden'>Blog</h1><PostIndex posts={page.data} /><Paginator {...paginationProps} /></main>
</PageLayout>
